# Copier ce fichier en .env (jamais commité) et remplir les valeurs.
# Générer une clé : python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Domaine personnalisé éventuel, ex. https://fermeapp.exemple.com (le domaine *.vercel.app est déjà autorisé)
CSRF_TRUSTED_ORIGINS=
# Supabase : Session pooler (port 5432) pour migrate/seed_demo ; Transaction pooler (port 6543) dans Vercel.
# Format : postgresql://postgres.<ref>:<MOT_DE_PASSE>@<hote>.pooler.supabase.com:5432/postgres
DATABASE_URL=
DEMO_ENABLED=True
